{% style %}
  .main-product-grid-section {
    padding: 16px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .product-grid {
    display: flex;
    justify-content: start;
    gap: 10px;
    flex-wrap: wrap;
    padding: 16px 50px;
  }

  .hero-image {
    position: relative;
    width: calc(33% - 10px);
  }
  .heading h2 {
    font-family: "Jost"
    , sans-serif;
    padding: 16px 50px;
    font-size: 36px;

  }
  @media screen and (max-width: 768px) {
    .hero-image {
      width: calc(50% - 10px);
    }
    .heading h2 {
      text-align: center;
      font-size: 18px;
    }
    .main-product-grid-section {
      padding: 0 8px;
    }
    .product-grid {
      padding: 0;
    }
    .popup-button svg {
      width: 22px;
      height: 22px;
    }
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .popup-button {
    position: absolute;
    cursor: pointer;
  }

  .custom-gift-card-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    justify-content: center;
    align-items: center;
  }
  .custom-gift-card-modal .overlay {
    display: block !important;
    position: absolute;
    inset: 0;
    background-color: rgba(25, 25, 25, 0.6);

  }
  .custom-gift-card-modal .card {

    z-index: 500;
    background: #fff;
    padding: 32px 16px 16px;
    position: relative;
    max-width: 320px;
  }
  .custom-gift-card-modal .card [data-close] {

    position: absolute;
    top: 0;
    right: 0;
    cursor: pointer;
  }

  .custom-gift-card-modal .details {


    /*
   font-family: jost;
   font-weight: 300;
   display: flex;
   flex-direction: row;
   gap: 12px;
*/
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 8px;
  }

  .custom-gift-card-modal .image-container {
    width: 120px;
    height: 140px;
    overflow: hidden;
  }
  .custom-gift-card-modal .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* options css */
  .custom-gift-card-modal .select-header {
    display: flex;
    justify-content: space-between;
    cursor: pointer;
  }
  .custom-gift-card-modal .select-header span {
    display: inline-block;
    text-align: center;
    width: 100%;
    padding: 8px;
    border: 1px solid;
  }
  .custom-gift-card-modal .up-down-icon {
    border: 1px solid;
    min-width: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-left: none;
  }
  /* PRODUCT INFO */
  .product-info {
    font-family: "jost";
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }
  .custom-gift-card-modal .title {
    margin: 0 !important;
    font-size: 16px;
    line-height: 120%;
    font-family: jost;
    font-weight: 300;
  }
  .product-info .price {
    font-weight: 400;
  }

  .product-info .description p {
    margin: 0;
    font-size: 14px;
    font-weight: 300;
  }
  /* SELECT OPTIONS CSS */
  .select-option-wrapper.select-open .up-down-icon svg {
    transform: rotate(180deg);
  }
  .select-option-wrapper ul {
    position: absolute;
    background: #fff;
    z-index: 2;
    width: 100%;
    top: 0;
    left: 0;
    display: none;
    margin-block-start: 0;
    padding-inline-start: 0;
    list-style: none;
    text-align: center;
    transition: all 0.2s ease;
    border: 1px solid black;
  }
  .select-values-wrapper {
    position: relative;
    width: 100%;
  }
  .select-option-wrapper.select-open ul {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .select-option-wrapper ul li:hover {
    background: #111;
    color: #fff;
    cursor: pointer;
  }

  .is-select-option {
    transform: rotate(180deg);
  }

  /* btns */
  .btn-options-wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    cursor: pointer;

  }
  .btn-options-wrapper button {
    cursor: pointer;
    position: relative;
    width: 100%;
    padding: 12px;
    background: none;
    border: 1px solid gray;
    font-size: 16px;
    text-align: left;
    transition: background 0.8s
    , color 0.5s;
  }
  .btn-options-wrapper button.isSelected {
    background: #222;
    color: #fff;
  }
  .btn-options-wrapper button::before {
    content: "";
    background: var(--btn-color);
    position: absolute;
    top: 0;
    left: 0;
    width: 5px;
    height: 100%;
  }
  .active-select {
    background: #222;
    color: #fff;
  }

  /* ADD TO CART CSS */
  .atc-button {
    text-transform: uppercase;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px 16px;
    background: black;
    color: #fff;
    margin-top: 24px;
    cursor: pointer;
    font-family: 'Jost';
    font-size: 16px;
    border: none;
  }
  .atc-button:disabled {
    background: gray;
  }


  /*
   .atc-button .initial-msg {
   display: none;
   }
   .atc-button:disabled .initial-msg {
   display: inline-block;
   text-align: center;
   background: green;
   font-size: 8px;
   font-family: jost;
   }
*/
  .success-with-atc {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: green;
  }
{% endstyle %}

<div class="main-product-grid-section">
  <div class="heading">
    <h2>{{ section.settings.product-grid-heading }}</h2>
  </div>
  <div class="product-grid">
    {% for block in section.blocks %}
      {% assign product = all_products[block.settings.grid-product] %}
      <div class="hero-image">
        {{ product.featured_image | image_url: width: "563" | image_tag }}
        <div
          class="popup-button"
          data-productId="{{ product.id }}"
          style="top:{{ block.settings.quickViewTop }}%;left:{{ block.settings.quickViewLeft }}%">
          {% render 'custom-gift-plus-icon' %}
        </div>
      </div>
      <div class="custom-gift-card-modal modal-{{ product.id }}" style="display:none">
        <script id="productData" type="application/json">
          {{ product | json }}
        </script>
        <div class="overlay" data-close></div>
        <div class="card">
          <div class="close" data-close>
            {% render 'custom-gift-close-icon' %}
          </div>
          <div class="details">
            <div class="image-container">
              {{ product.featured_image | image_url: width: 120 | image_url: height: 140 | image_tag }}
            </div>
            <div class="product-info">
              <h3 class="title">
                {{ product.title | truncate: 30 }}
              </h3>
              <div class="price">
                {{ product.price | money_with_currency }}
              </div>
              <div class="description">
                {{ product.description | truncate: 75, '...' }}
              </div>
            </div>
          </div>
          <div class="form-content">
            <div class="product-options">
              <div class="custom-options">
                {% for option in product.options_with_values %}
                  {% assign optionName = option.name %}
                  <p>{{ option.name }}</p>
                  {% if optionName == 'color' or optionName == 'Color' %}
                    <div class="btn-options-wrapper">
                      {% for value in option.values %}
                        <div class="option-btn-wrapper">
                          <button
                            class="btn-option"
                            data-value="{{ value }}"
                            data-optionname="{{optionName}}">
                            {{ value }}
                          </button>
                        </div>
                      {% endfor %}
                    </div>

                  {% else %}
                    <div class="select-option-wrapper">
                      <div class="select-header">
                        <span>Choose Your size</span>
                        <div class="up-down-icon">
                          {% render 'custom-gift-up-down-icon' %}
                        </div>
                      </div>
                      <div class="select-values-wrapper">
                        <ul>
                          {% for value in option.values %}
                            <li
                              class="select-option"
                              data-value="{{value}}"
                              data-optionname="{{optionName}}">{{ value }}</li>
                          {% endfor %}
                        </ul>
                      </div>

                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
            <div class="atc-wrapper">
              <input
                type="hidden"
                name="selectedVariant"
                id="selectedVariant">
              <button class="atc-button">
                <span>Add To Cart</span>
                <div class="custom-arrow-icon">
                  {% render 'custom-gift-white-arrow' %}
                </div>
              </button>

            </div>
            <div class="success-with-atc">
              <p></p>
              <a href="{{ routes.cart_url }}" id="cart-icon-bubble">Go To Cart</a>
            </div>
            <div class="errors-atc" style="text-align: center; display:none; color:red">
              Please Select Variant Options
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<script src="{{ 'custom-gift-card-product-grid.js' | asset_url }}" defer="defer"></script>


{% schema %}
  {
    "name": "Product Grid Block",
    "settings": [
      {
        "type": "text",
        "default": "Tisso vison in the wild",
        "id": "product-grid-heading",
        "label": "Product Grid Heading"
      }

    ],
    "blocks": [
      {
        "name": "product-card",
        "type": "product",
        "settings": [
          {
            "type": "product",
            "id": "grid-product",
            "label": "Assign Grid Product"
          }, {
            "type": "range",
            "min": 1,
            "max": 100,
            "step": 1,
            "unit": "%",
            "id": "quickViewTop",
            "default": 70,
            "label": "Set Quick View Button From Top"
          }, {
            "type": "range",
            "min": 1,
            "max": 100,
            "step": 1,
            "unit": "%",
            "id": "quickViewLeft",
            "default": 70,
            "label": "Set Quick View Button From Left"
          }
        ],
        "limit": 6
      }
    ],
    "presets": [
      {
        "name": "Product Grid Block"
      }
    ]
  }


{% endschema %}